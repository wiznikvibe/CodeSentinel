# ==============================================================================
# CodeSentinel - Environment Variable Examples
# ==============================================================================
# This file documents all required environment variables for CodeSentinel.
# Copy to .env and fill in real values before running the application.
# Never commit .env to version control.
#
# Format: VARIABLE_NAME=default_value_or_description
# Required vars must be set; optional vars have sensible defaults.
# ==============================================================================

# ==== LLM Configuration ====
# Provider to use for LLM calls. Options: openai, anthropic, local
LLM_PROVIDER=openai
# LLM model name (e.g. gpt-4o-mini, gpt-4o, claude-3-haiku-20240307)
LLM_MODEL=gpt-4o-mini
# Sampling temperature for LLM calls (0.0 = deterministic, 2.0 = creative)
# Range: 0.0 - 2.0
LLM_TEMPERATURE=0.1

# ==== Authentication Keys (REQUIRED) ====
# OpenAI API key (sk-...). Required if LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key-here
# Anthropic API key (sk-ant-...). Required if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ==== LangGraph Checkpointer ====
# PostgreSQL connection string for LangGraph checkpoint persistence
# Format: postgresql://user:password@host:port/database
# Required when using LangGraph checkpointing (recommended)
CHECKPOINT_DB_URL=postgresql://codesentinel:codesentinel@localhost:5432/codesentinel

# ==== Redis ====
# Redis URL for caching and job queues (optional - defaults to redis://localhost:6379/0)
# Format: redis://host:port/database
REDIS_URL=redis://localhost:6379/0

# ==== Jenkins Integration ====
# Jenkins server URL for CI/CD integration
JENKINS_URL=https://jenkins.example.com
# Jenkins username for authentication
JENKINS_USER=agent-bot
# Jenkins API token / password for authentication (keeps secrets out of .env)
JENKINS_TOKEN=***

# ==== SonarQube Integration ====
# SonarQube server URL for code quality analysis
SONARQUBE_URL=https://sonar.example.com
# SonarQube authentication token (keeps secrets out of .env)
SONARQUBE_TOKEN=***

# ==== ECS Deployment ====
# ECS cluster name where the CodeSentinel task runs
ECS_CLUSTER=code-review-cluster
# ECS task family name (used for task definition lookup)
ECS_TASK_FAMILY=code-review-agent

# ==== AWS Configuration ====
# AWS region for ECS/S3/SQS operations
AWS_REGION=us-east-1
# Optional: LocalStack endpoint URL for local development/testing
# AWS_ENDPOINT_URL=http://localhost:4566